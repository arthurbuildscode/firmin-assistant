[Unit]
Description=Firmin Assistant - serveur d'outils MCP persistant (HTTP local, un jeton par personne)
Documentation=file:///srv/home-os/docs/spec-lot7-serveur-outils.md
After=network-online.target homeos-web.service
Wants=network-online.target

[Service]
# Lot 7 : seul détenteur des secrets utiles aux outils (URLs iCal, clé du coffre, session Kitchen Daily), lus
# dans /etc/homeos et /var/lib/homeos par le processus lui-même (rien dans l'environnement). Les sessions Claude
# des personnes le joignent en HTTP sur 127.0.0.1 avec leur jeton (wrapper homeos-claude).
UMask=0002
Type=simple
User=homeos
Group=foyer
# Group= remplace le groupe primaire et retire les groupes secondaires : on remet homeos, propriétaire
# de groupe des fichiers /etc/homeos/*.env (640 root:homeos).
SupplementaryGroups=homeos
WorkingDirectory=/srv/home-os
Environment=HOMEOS_ROOT=/srv/home-os
Environment=HOMEOS_DATA=/srv/home-os/data
Environment=HOMEOS_ETAT=/var/lib/homeos
Environment=HOMEOS_SECRETS=/etc/homeos
Environment=PYTHONPATH=/srv/home-os
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
Environment=PYTHONUNBUFFERED=1
Environment=DISABLE_AUTOUPDATER=1
# Mode et port (HOMEOS_OUTILS_PORT), proxy sortant filtrant s'il est activé : fichiers sans secret.
EnvironmentFile=-/etc/default/homeos-outils
EnvironmentFile=-/etc/default/homeos-proxy
ExecStart=/srv/home-os/.venv/bin/python -m tools.server --transport http --hote 127.0.0.1
# systemctl reload homeos-outils : relit les jetons et recharge les capacités sans couper le service
# (lancé automatiquement par homeos-appliquer-config après enable/disable d'une capacité).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# Durcissement (lot 5d, profil strict des services sans sudo).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/home-os/data /var/lib/homeos
ProtectHome=tmpfs
BindPaths=/home/homeos
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Chromium tourne dans homeos-web ; en repli local (HOMEOS_NAVIGATEUR=local) prévoir un drop-in MemoryMax=2G.
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
