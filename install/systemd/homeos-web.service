[Unit]
Description=Firmin Assistant - navigateur isolé (serveur Playwright sous homeos-web, sans accès aux données)
Documentation=file:///srv/home-os/docs/spec-lot7-serveur-outils.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/homeos/navigateur.env

[Service]
# Lot 7 : Chromium ne tourne plus sous homeos ni sous les personnes. Le serveur d'outils (et le runner, les crons)
# s'y connectent en websocket local (adresse avec un chemin secret, /etc/homeos/navigateur.env), lui transmettent
# la session Kitchen Daily en mémoire et récupèrent captures et session rafraîchie en octets.
Type=simple
User=homeos-web
Group=homeos-web
# Port et chemin secret (HOMEOS_NAVIGATEUR_PORT, HOMEOS_NAVIGATEUR_CHEMIN) : lus par systemd, en root.
EnvironmentFile=/etc/homeos/navigateur.env
EnvironmentFile=-/etc/default/homeos-proxy
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
Environment=HOME=/var/lib/homeos-web
StateDirectory=homeos-web
StateDirectoryMode=0700
WorkingDirectory=/var/lib/homeos-web
ExecStart=/srv/home-os/.venv/bin/playwright run-server --host 127.0.0.1 --port ${HOMEOS_NAVIGATEUR_PORT} --path /${HOMEOS_NAVIGATEUR_CHEMIN} --max-clients 2
Restart=always
RestartSec=5
# Durcissement : aucune donnée du foyer visible, écriture seulement dans /var/lib/homeos-web.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/srv/home-os/data -/var/lib/homeos -/var/lib/homeos-cwd -/etc/homeos -/var/backups/homeos
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Pas de MemoryDenyWriteExecute (JIT de V8) ni de RestrictNamespaces (sandbox éventuel de Chromium).
MemoryMax=1500M
TasksMax=512

[Install]
WantedBy=multi-user.target
