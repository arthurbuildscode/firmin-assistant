[Unit]
Description=Firmin Assistant - timer brief du jour

[Timer]
# Valeur par défaut du contrat ; install.sh génère un drop-in depuis data/config.yaml
OnCalendar=*-*-* 07:15:00
# Lot 5d : rattrape un tir manqué (VPS arrêté ou redémarré à l'heure du brief)
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
