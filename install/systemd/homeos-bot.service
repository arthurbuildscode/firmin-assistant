[Unit]
Description=Firmin Assistant - bot Telegram
After=network-online.target
Wants=network-online.target

[Service]
UMask=0002
Type=simple
User=homeos
Group=foyer
SupplementaryGroups=homeos
WorkingDirectory=/srv/home-os
# Secrets au strict besoin : token Telegram, clé API (personnes en mode cle_api, /brief à la demande)
EnvironmentFile=-/etc/homeos/telegram.env
EnvironmentFile=-/etc/homeos/anthropic.env
Environment=HOMEOS_DATA=/srv/home-os/data
Environment=HOMEOS_ETAT=/var/lib/homeos
Environment=HOMEOS_SECRETS=/etc/homeos
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
Environment=DISABLE_AUTOUPDATER=1
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Proxy sortant filtrant, seulement si install.sh --filtrer-sortant l'a activé
EnvironmentFile=-/etc/default/homeos-proxy
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/home-os/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
# Durcissement (lot 5d, audit point 6). Le bot lance « sudo -u <personne> homeos-claude » : pas de
# NoNewPrivileges, et aucune option qui l'implique pour un service non root (PrivateDevices,
# RestrictAddressFamilies, SystemCallArchitectures, LockPersonality, RestrictRealtime,
# ProtectKernelModules, RestrictSUIDSGID). ProtectHome reste désactivé : le claude des personnes hérite de
# l'espace de noms et écrit dans /home/<personne>/.claude. Pas de MemoryDenyWriteExecute (JIT de Node) ni
# de RestrictNamespaces (sandbox de Chromium).
ProtectSystem=strict
ReadWritePaths=/srv/home-os/data -/var/lib/homeos /home -/var/log/sudo-homeos.log -/run/sudo
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=5000M
TasksMax=512

[Install]
WantedBy=multi-user.target
