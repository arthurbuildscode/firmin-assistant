[Unit]
Description=Firmin Assistant - vérification hebdomadaire de l'étanchéité des secrets
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root : doit pouvoir lancer des commandes sous chaque personne pour vérifier ce qu'elles NE peuvent PAS lire.
User=root
WorkingDirectory=/srv/home-os
EnvironmentFile=-/etc/homeos/telegram.env
Environment=HOMEOS_DATA=/srv/home-os/data
Environment=DISABLE_AUTOUPDATER=1
ExecStart=/srv/home-os/scripts/verifier-secrets.sh --alerte
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=1500M
