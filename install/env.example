# Firmin Assistant — secrets : modèle des fichiers de /etc/homeos (lot 5d).
# Valeurs d'exemple uniquement. Ne jamais commiter les vrais fichiers.
#
# Depuis le lot 5d, les secrets ne sont plus dans data/ (lisible par les sessions Claude) mais dans
# /etc/homeos (750 root:foyer), un fichier par usage, lisible seulement par qui en a besoin.
# install.sh crée ces fichiers, migre l'ancien data/secrets.env (scripts/migrer-secrets.sh) et génère
# RESTIC_PASSWORD et COFFRE_CLE. Les unités systemd reçoivent leurs secrets par EnvironmentFile=.
# Édition : sudo nano /etc/homeos/<fichier>.env, puis sudo systemctl restart homeos-bot.

# ---- /etc/homeos/telegram.env (640 root:homeos) — bot, briefs, alertes ---------------------------------------
# Token du bot Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeTokenBotFatherRemplaceMoi

# ---- /etc/homeos/anthropic.env (640 root:homeos) — crons (--bare) et personnes en mode cle_api -----------------
# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-EXEMPLE-remplace-moi

# ---- /etc/homeos/ical.env (640 root:homeos ; root:foyer en stdio) — agendas communs, lus par le serveur d'outils -
# URLs iCal secrètes (Paramètres de l'agenda → « Adresse secrète au format iCal ») ; noms = ical_url_env de config.yaml
ICAL_FOYER=https://calendar.google.com/calendar/ical/exemple-foyer%40group.calendar.google.com/private-xxxxxxxx/basic.ics
ICAL_ALEX=https://calendar.google.com/calendar/ical/exemple-alex%40exemple.fr/private-xxxxxxxx/basic.ics
ICAL_CAMILLE=https://calendar.google.com/calendar/ical/exemple-camille%40exemple.fr/private-xxxxxxxx/basic.ics
# Agenda privé (config.yaml : `prive: <linux_user>`) : sa variable va dans /etc/homeos/ical-<linux_user>.env
# (640 root:homeos ; root:<linux_user> en stdio), lue pour cette personne seulement (jeton du serveur d'outils).

# ---- /etc/homeos/restic.env (600 root:root) — lu par systemd seulement (homeos-backup, homeos-restaurer-test) --
# Mot de passe du dépôt local /var/backups/homeos (généré par install.sh — à conserver hors du VPS !)
RESTIC_PASSWORD=
# Copie hors site (scripts/configurer-hors-site.sh, docs/sauvegardes.md) : dépôt rclone Google Drive,
# mot de passe DISTINCT (gestionnaires de mots de passe des deux conjoints), configuration rclone.
# RESTIC_REPOSITORY_DISTANT=rclone:gdrive:homeos-sauvegardes
# RESTIC_PASSWORD_DISTANT=
# RCLONE_CONFIG=/var/lib/homeos/rclone/rclone.conf

# ---- /etc/homeos/coffre.env (640 root:homeos) — coffre à secrets /var/lib/homeos/coffre.json -----------------
# Clé de chiffrement du coffre (générée par install.sh — à conserver hors du VPS avec RESTIC_PASSWORD !)
COFFRE_CLE=
# Optionnel — backend de coffre « vaultwarden » (pas encore implémenté, voir docs/coffre.md)
# VAULTWARDEN_URL=https://coffre.exemple.fr
# VAULTWARDEN_CLIENT_ID=user.00000000-0000-0000-0000-000000000000
# VAULTWARDEN_CLIENT_SECRET=
# VAULTWARDEN_MOT_DE_PASSE_MAITRE=

# ---- /etc/default/homeos-proxy (644, sans secret) — écrit par install.sh --filtrer-sortant -------------------
# HTTPS_PROXY=http://127.0.0.1:3128
# HTTP_PROXY=http://127.0.0.1:3128
# NO_PROXY=127.0.0.1,localhost,::1

# ---- Lot 7 : serveur d'outils persistant et navigateur isolé (générés par install.sh, ne pas remplir) ---------
# /etc/default/homeos-outils (644, sans secret) : mode des outils MCP, lu par le wrapper, le bot, le healthcheck.
# HOMEOS_OUTILS=http                     (stdio : retour arrière, install.sh --outils=stdio)
# HOMEOS_OUTILS_URL=http://127.0.0.1:8090/mcp
# HOMEOS_OUTILS_PORT=8090
# /etc/homeos/outils-jetons.env (640 root:homeos) : un jeton par utilisateur (scripts/jetons-outils.sh) ;
# chaque personne a une copie du sien dans ~/.config/homeos/jeton (600).
# JETON_homeos=<64 caractères hexadécimaux>
# JETON_<linux_user>=<64 caractères hexadécimaux>
# /etc/homeos/navigateur.env (640 root:homeos) : adresse du navigateur isolé homeos-web (chemin secret).
# HOMEOS_NAVIGATEUR_PORT=8091
# HOMEOS_NAVIGATEUR_CHEMIN=<48 caractères hexadécimaux>
# HOMEOS_NAVIGATEUR_WS=ws://127.0.0.1:8091/<chemin>
