# Firmin Assistant — versions épinglées (lot 5d, audit point 3).
# Lu par install/install.sh, scripts/maj-navigateur.sh et install/vaultwarden.sh. Une montée de version est
# une décision explicite : modifier ici, relancer install.sh, puis scripts/verifier.sh (pytest, ruff,
# vérification des secrets, `claude -p "ok"`).
#
# À VÉRIFIER avant le premier déploiement : valeurs relevées dans les registres publics
# (npm, PyPI, Docker Hub), non encore testées sur le VPS.

# Claude Code (npm @anthropic-ai/claude-code). Minimum 2.1.259 (--permission-prompts) ;
# 2.1.257+ pour permissions.blockReadsOutsideWorkingDirectories. À vérifier.
CLAUDE_CODE=2.1.319

# Playwright (PyPI) et son Chromium (installé dans /opt/playwright). À vérifier.
PLAYWRIGHT=1.64.1

# Node.js : version majeure du dépôt NodeSource (deb.nodesource.com/node_<N>.x). À vérifier.
NODE_MAJOR=22

# Vaultwarden (install/vaultwarden.sh, optionnel, pas encore exposé). À vérifier.
VW_IMAGE=docker.io/vaultwarden/server:1.37.5

# Piper (PyPI piper-tts, synthèse vocale de l'appli web, lot 4a), installé dans /opt/piper/venv. À vérifier.
# Voix : PIPER_VOIX (défaut fr_FR-siwis-medium, dépôt rhasspy/piper-voices v1.0.0) ; alternative fr_FR-upmc-medium.
PIPER_TTS=1.3.0
PIPER_VOIX=fr_FR-siwis-medium
